{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/epistemic-record.schema.json",
  "title": "JARVIS Epistemic Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "created_by",
    "immutable",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": { "type": "string", "minLength": 1 },
    "record_type": {
      "enum": ["OBSERVATION", "EVIDENCE", "CLAIM", "BELIEF", "DECISION", "UNKNOWN"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "immutable": { "type": "boolean" },
    "supersedes_record_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "OBSERVATION" } } },
      "then": {
        "properties": {
          "immutable": { "const": true },
          "payload": {
            "required": ["source_id", "acquisition_method", "content_hash", "captured_at", "environment_context"]
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "EVIDENCE" } } },
      "then": {
        "properties": {
          "immutable": { "const": true },
          "payload": {
            "required": ["provenance", "captured_at", "locator", "integrity_hash", "retrieval_method"]
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "CLAIM" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["proposition", "supporting_evidence_ids", "contradicting_evidence_ids", "confidence", "verification_state"]
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "BELIEF" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["claim_ids", "confidence", "rationale", "evaluated_at"]
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "DECISION" } } },
      "then": {
        "properties": {
          "immutable": { "const": true },
          "payload": {
            "required": ["selected_action", "alternatives", "rationale", "goal_ids", "owner_vetoes_checked", "evidence_ids", "uncertainty", "outcome_measurement"]
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "UNKNOWN" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["question", "importance", "expected_information_value", "research_cost", "dependencies", "status"]
          }
        }
      }
    }
  ]
}
