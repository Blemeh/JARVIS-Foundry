{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/resource-record.schema.json",
  "title": "JARVIS Autonomous Resource Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "status",
    "resource_type",
    "display_name",
    "identity",
    "capability",
    "recovery"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "resource_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["DISCOVERED", "PROBING", "READY", "ACTIVE", "DEGRADED", "VETOED", "STOPPED"]
    },
    "resource_type": {
      "enum": ["git_worktree", "repository", "folder", "obsidian_vault", "application", "provider", "external_system", "account"]
    },
    "display_name": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": ["canonical_absolute_path", "discovered_at"],
      "properties": {
        "canonical_absolute_path": { "type": ["string", "null"] },
        "external_identifier": { "type": ["string", "null"] },
        "parent_repository_path": { "type": ["string", "null"] },
        "content_or_state_hash": { "type": ["string", "null"] },
        "discovered_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "target_resolution": { "type": "object" },
    "git": { "type": "object" },
    "commands": { "type": "object" },
    "capability": {
      "type": "object",
      "required": ["state", "readiness_evidence", "active_owner_vetoes"],
      "properties": {
        "state": {
          "enum": ["DISCOVERED", "PROBING", "READY", "ACTIVE", "DEGRADED", "VETOED", "STOPPED"]
        },
        "readiness_evidence": { "type": "array", "items": { "type": "string" } },
        "active_owner_vetoes": { "type": "array", "items": { "type": "string" } },
        "maximum_concurrent_writers": { "type": "integer", "minimum": 1 }
      }
    },
    "recovery": { "type": "object" },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
