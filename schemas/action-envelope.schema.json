{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/action-envelope.schema.json",
  "title": "JARVIS Autonomous ActionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "mission_id",
    "actor_id",
    "goal_ids",
    "target_resource_ids",
    "operation",
    "capabilities_required",
    "owner_vetoes_checked",
    "risk_class",
    "idempotency_key",
    "expires_at",
    "decision"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "action_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": ["string", "null"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "goal_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "target_resource_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "capabilities_required": { "type": "array", "items": { "type": "string" } },
    "owner_vetoes_checked": { "type": "array", "items": { "type": "string" } },
    "expected_effect": { "type": ["string", "null"] },
    "risk_class": { "enum": ["C0", "C1", "C2", "C3"] },
    "reversibility": { "enum": ["reversible", "compensatable", "irreversible", "unknown"] },
    "verification_plan": { "type": ["string", "null"] },
    "rollback_or_compensation": { "type": ["string", "null"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "budget_estimate": { "type": ["number", "null"], "minimum": 0 },
    "expires_at": { "type": "string", "format": "date-time" },
    "decision": {
      "enum": ["PENDING", "ALLOW", "VETOED", "NOT_READY", "MISSING_RECOVERY_PATH", "BUDGET_CONSTRAINT_REACHED", "EMERGENCY_STOPPED", "INVALID_TARGET"]
    },
    "decision_reason": { "type": ["string", "null"] },
    "decided_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
