{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/remaster/r1/purpose-protocol-v1.schema.json",
  "title": "JARVIS implementation-independent purpose subprocess protocol v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "protocol_version", "request_id", "evaluation_time", "run_root", "purpose_spec_sha256", "observer_registry_sha256", "requested_proof_scope", "challenge_nonce", "evaluator_authority_id", "observer_id", "contracts"],
      "properties": {
        "schema": {"const": "jarvis-purpose-request-v1"},
        "protocol_version": {"const": "jarvis-purpose-protocol-v1"},
        "request_id": {"type": "string", "minLength": 8},
        "evaluation_time": {"type": "string", "format": "date-time"},
        "run_root": {"type": "string", "minLength": 1},
        "purpose_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observer_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requested_proof_scope": {"enum": ["HARNESS_SELF_TEST", "PRODUCT_LIVE"]},
        "challenge_nonce": {"type": "string", "minLength": 16},
        "evaluator_authority_id": {"type": "string", "minLength": 8},
        "observer_id": {"type": ["string", "null"], "minLength": 8},
        "contracts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["journey_id", "contract_sha256", "contract"],
            "properties": {
              "journey_id": {"type": "string", "pattern": "^J(0[1-9]|10)$"},
              "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "contract": {"type": "object"}
            }
          }
        }
      }
    },
    "adapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "system_identity", "system_release", "actor_run_id", "verifier_run_id", "proof_scope"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 4},
        "adapter_version": {"type": "string", "minLength": 3},
        "system_identity": {"type": "string", "minLength": 4},
        "system_release": {"type": "string", "minLength": 4},
        "actor_run_id": {"type": "string", "minLength": 4},
        "verifier_run_id": {"type": "string", "minLength": 4},
        "proof_scope": {"enum": ["HARNESS_SELF_TEST", "PRODUCT_LIVE"]}
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "calls", "tokens", "effects", "cost_usd"],
      "properties": {
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "calls": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "effects": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "stopVeto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_checked", "veto_checked", "forged_content_ignored", "control_actor_id", "control_source"],
      "properties": {
        "stop_checked": {"type": "boolean"},
        "veto_checked": {"type": "boolean"},
        "forged_content_ignored": {"type": "boolean"},
        "control_actor_id": {"type": "string", "minLength": 4},
        "control_source": {"const": "AUTHENTICATED_OWNER_CONTROL"}
      }
    },
    "targetReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "canonical_identity", "account_or_service_identity", "before_state_sha256", "after_state_sha256", "receipt_id", "idempotency_key"],
      "properties": {
        "target_id": {"type": "string", "minLength": 4},
        "canonical_identity": {"type": "string", "minLength": 4},
        "account_or_service_identity": {"type": "string", "minLength": 4},
        "before_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "after_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_id": {"type": "string", "minLength": 4},
        "idempotency_key": {"type": "string", "minLength": 4}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "locator", "capture_method"],
      "properties": {
        "source_id": {"type": "string", "minLength": 4},
        "source_type": {"type": "string", "minLength": 4},
        "locator": {"type": "string", "minLength": 3},
        "capture_method": {"type": "string", "minLength": 5}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "run_id", "role"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 4},
        "run_id": {"type": "string", "minLength": 4},
        "role": {"enum": ["ACTOR", "INDEPENDENT_VERIFIER", "CONTROL_PLANE"]}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "valid_until"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "statement"],
      "properties": {
        "level": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
        "statement": {"type": "string", "minLength": 8}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size", "media_type", "summary"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 3},
        "summary": {"type": "string", "minLength": 8}
      }
    },
    "evidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "criterion_ids", "kind", "phase", "proof_dimension", "source", "captured_at", "target_id", "before_state", "after_state", "real_or_fixture", "proof_scope", "producer", "freshness", "uncertainty", "contradictions", "content"],
      "properties": {
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "kind": {"type": "string", "minLength": 4},
        "phase": {"enum": ["INPUT", "SOURCE", "BEFORE", "DECISION", "CONTROL", "AFTER", "RECOVERY", "ROLLBACK", "COMPENSATION", "VERIFICATION", "LEARNING"]},
        "proof_dimension": {"type": "string", "minLength": 5},
        "source": {"$ref": "#/$defs/source"},
        "captured_at": {"type": "string", "format": "date-time"},
        "target_id": {"type": "string", "minLength": 4},
        "before_state": {"type": ["object", "null"]},
        "after_state": {"type": ["object", "null"]},
        "real_or_fixture": {"enum": ["REAL_TEMPORARY_EFFECT", "REAL_EXTERNAL_EFFECT", "FIXTURE", "STATIC_IDENTITY"]},
        "proof_scope": {"enum": ["HARNESS_SELF_TEST", "PRODUCT_LIVE"]},
        "producer": {"$ref": "#/$defs/producer"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "contradictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
        "content": {"$ref": "#/$defs/content"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "payload_sha256", "payload"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload": {"$ref": "#/$defs/evidencePayload"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useful", "after_state_verified", "idempotent", "duplicate_effect_count", "contradictions_preserved", "recovery_verified", "rollback_verified", "compensation_verified", "result_summary"],
      "properties": {
        "useful": {"type": "boolean"},
        "after_state_verified": {"type": "boolean"},
        "idempotent": {"type": "boolean"},
        "duplicate_effect_count": {"type": "integer", "minimum": 0},
        "contradictions_preserved": {"type": "boolean"},
        "recovery_verified": {"type": "boolean"},
        "rollback_verified": {"type": "boolean"},
        "compensation_verified": {"type": "boolean"},
        "result_summary": {"type": "string", "minLength": 20}
      }
    },
    "blockedStatusDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "explanation", "criterion_ids", "evidence_ids", "detail"],
      "properties": {
        "status": {"const": "BLOCKED"},
        "reason_code": {"enum": ["EXTERNAL_DEPENDENCY_UNAVAILABLE", "MISSING_CREDENTIAL", "REQUIRED_PHYSICAL_ACT", "CONTRADICTORY_OWNER_DIRECTIVES"]},
        "explanation": {"type": "string", "minLength": 20},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dependency_id", "dependency_kind", "unavailable_observation_evidence_id", "retry_policy", "unblock_condition"],
          "properties": {
            "dependency_id": {"type": "string", "minLength": 4},
            "dependency_kind": {"type": "string", "minLength": 4},
            "unavailable_observation_evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "retry_policy": {"type": "string", "minLength": 12},
            "unblock_condition": {"type": "string", "minLength": 12}
          }
        }
      }
    },
    "waitingStatusDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "explanation", "criterion_ids", "evidence_ids", "detail"],
      "properties": {
        "status": {"const": "WAITING"},
        "reason_code": {"enum": ["DURABLE_EVENT_PENDING", "STOP_OR_VETO_ACTIVE", "BOUNDED_BACKOFF"]},
        "explanation": {"type": "string", "minLength": 20},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wait_event_id", "event_source", "resume_condition", "resumption_mode", "next_check_at"],
          "properties": {
            "wait_event_id": {"type": "string", "minLength": 4},
            "event_source": {"type": "string", "minLength": 4},
            "resume_condition": {"type": "string", "minLength": 12},
            "resumption_mode": {"enum": ["EVENT_DRIVEN", "BOUNDED_POLL"]},
            "next_check_at": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      }
    },
    "notTestedStatusDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "explanation", "criterion_ids", "evidence_ids", "detail"],
      "properties": {
        "status": {"const": "NOT_TESTED"},
        "reason_code": {"enum": ["CRITERIA_NOT_EXECUTED", "FRESHNESS_EXPIRED", "CAPABILITY_NOT_EXERCISED"]},
        "explanation": {"type": "string", "minLength": 20},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unexecuted_criterion_ids", "why_not_exercised"],
          "properties": {
            "unexecuted_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
            "why_not_exercised": {"type": "string", "minLength": 20}
          }
        }
      }
    },
    "failStatusDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "explanation", "criterion_ids", "evidence_ids", "detail"],
      "properties": {
        "status": {"const": "FAIL"},
        "reason_code": {"enum": ["CRITERION_FAILED", "IMPLEMENTATION_DEFECT", "PROTOCOL_FAILURE", "CONTROL_VIOLATION"]},
        "explanation": {"type": "string", "minLength": 20},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failed_criterion_ids", "failure_kind", "failure_observation_evidence_id"],
          "properties": {
            "failed_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^J(0[1-9]|10)-S[0-9]{2}$"}},
            "failure_kind": {"enum": ["CRITERION_FAILURE", "IMPLEMENTATION_FAILURE", "PROTOCOL_FAILURE", "CONTROL_FAILURE"]},
            "failure_observation_evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "statusDetail": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/blockedStatusDetail"},
        {"$ref": "#/$defs/waitingStatusDetail"},
        {"$ref": "#/$defs/notTestedStatusDetail"},
        {"$ref": "#/$defs/failStatusDetail"}
      ]
    },
    "journeyExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "status", "target_ids", "budget_usage", "stop_veto", "effect_classes", "target_receipts", "evidence", "criterion_evidence", "failure_injections_exercised", "outcome", "status_detail"],
      "properties": {
        "journey_id": {"type": "string", "pattern": "^J(0[1-9]|10)$"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "WAITING"]},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
        "budget_usage": {"$ref": "#/$defs/budgetUsage"},
        "stop_veto": {"$ref": "#/$defs/stopVeto"},
        "effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
        "target_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/targetReceipt"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "criterion_evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {"^J(0[1-9]|10)-S[0-9]{2}$": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        "failure_injections_exercised": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "outcome": {"$ref": "#/$defs/outcome"},
        "status_detail": {"$ref": "#/$defs/statusDetail"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "protocol_version", "request_id", "adapter", "journeys"],
      "properties": {
        "schema": {"const": "jarvis-purpose-response-v1"},
        "protocol_version": {"const": "jarvis-purpose-protocol-v1"},
        "request_id": {"type": "string", "minLength": 8},
        "adapter": {"$ref": "#/$defs/adapterIdentity"},
        "journeys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/journeyExecution"}}
      }
    },
    "observerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "protocol_version", "request_id", "requested_proof_scope", "evaluator_authority_id", "challenge_nonce", "observer_id", "observer_artifact_sha256", "actor_artifact_sha256", "actor_response_sha256", "actor_execution_identity", "observer_execution_identity", "adapter_claim", "journey_claims"],
      "properties": {
        "schema": {"const": "jarvis-purpose-observer-request-v1"},
        "protocol_version": {"const": "jarvis-purpose-protocol-v1"},
        "request_id": {"type": "string", "minLength": 8},
        "requested_proof_scope": {"const": "PRODUCT_LIVE"},
        "evaluator_authority_id": {"type": "string", "minLength": 8},
        "challenge_nonce": {"type": "string", "minLength": 16},
        "observer_id": {"type": "string", "minLength": 8},
        "observer_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_execution_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observer_execution_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adapter_claim": {"$ref": "#/$defs/adapterIdentity"},
        "journey_claims": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/journeyExecution"}}
      }
    },
    "observerTargetObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "canonical_identity", "account_or_service_identity", "source_identity_sha256", "external_target_locator", "before_state_sha256", "after_state_sha256", "effect_or_provider_receipt_id", "idempotency_key"],
      "properties": {
        "target_id": {"type": "string", "minLength": 4},
        "canonical_identity": {"type": "string", "minLength": 4},
        "account_or_service_identity": {"type": "string", "minLength": 4},
        "source_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "external_target_locator": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"},
        "before_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "after_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effect_or_provider_receipt_id": {"type": "string", "minLength": 4},
        "idempotency_key": {"type": "string", "minLength": 4}
      }
    },
    "failureInjectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injection_id", "observation_receipt_id"],
      "properties": {
        "injection_id": {"type": "string", "minLength": 5},
        "observation_receipt_id": {"type": "string", "minLength": 4}
      }
    },
    "semanticObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_injection_receipts", "restart_receipt_id", "duplicate_delivery_receipt_id", "recovery_receipt_id", "rollback_receipt_id", "compensation_receipt_id", "usefulness_receipt_id", "after_state_receipt_id", "stop_veto_receipt_id"],
      "properties": {
        "failure_injection_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/failureInjectionReceipt"}},
        "restart_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "duplicate_delivery_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "recovery_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "rollback_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "compensation_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "usefulness_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "after_state_receipt_id": {"type": ["string", "null"], "minLength": 4},
        "stop_veto_receipt_id": {"type": ["string", "null"], "minLength": 4}
      }
    },
    "observerJourney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "target_observations", "semantic_observations"],
      "properties": {
        "journey_id": {"type": "string", "pattern": "^J(0[1-9]|10)$"},
        "target_observations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/observerTargetObservation"}},
        "semantic_observations": {"$ref": "#/$defs/semanticObservations"}
      }
    },
    "observerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "protocol_version", "request_id", "observer_id", "observer_artifact_sha256", "evaluator_authority_id", "challenge_nonce", "actor_artifact_sha256", "actor_response_sha256", "actor_execution_identity", "observer_execution_identity", "journeys"],
      "properties": {
        "schema": {"const": "jarvis-purpose-observer-response-v1"},
        "protocol_version": {"const": "jarvis-purpose-protocol-v1"},
        "request_id": {"type": "string", "minLength": 8},
        "observer_id": {"type": "string", "minLength": 8},
        "observer_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluator_authority_id": {"type": "string", "minLength": 8},
        "challenge_nonce": {"type": "string", "minLength": 16},
        "actor_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor_execution_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observer_execution_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "journeys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/observerJourney"}}
      }
    },
    "observerTargetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "canonical_identity", "account_or_service_identity"],
      "properties": {
        "target_id": {"type": "string", "minLength": 4},
        "canonical_identity": {"type": "string", "minLength": 4},
        "account_or_service_identity": {"type": "string", "minLength": 4}
      }
    },
    "observerRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_id", "artifact_path", "artifact_sha256", "command_prefix", "target_bindings"],
      "properties": {
        "observer_id": {"type": "string", "minLength": 8},
        "artifact_path": {"type": "string", "minLength": 3},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "command_prefix": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
