{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/remaster/r1/journey-contract-v1.schema.json",
  "title": "JARVIS purpose journey contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "journey_id",
    "name",
    "purpose",
    "inputs",
    "preconditions",
    "canonical_targets",
    "budget",
    "required_evidence",
    "success_criteria",
    "unacceptable_outcomes",
    "intervention_rules",
    "failure_injections",
    "recovery",
    "rollback",
    "proof_dimensions",
    "executable_requirements"
  ],
  "properties": {
    "schema": {"const": "jarvis-purpose-journey-v1"},
    "contract_version": {"const": "1.0.0"},
    "journey_id": {"type": "string", "pattern": "^J(0[1-9]|10)$"},
    "name": {"type": "string", "minLength": 12},
    "purpose": {"type": "string", "minLength": 30},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "preconditions": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/precondition"}
    },
    "canonical_targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "budget": {"$ref": "#/$defs/budget"},
    "required_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/evidenceRequirement"}
    },
    "success_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/successCriterion"}
    },
    "unacceptable_outcomes": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/unacceptableOutcome"}
    },
    "intervention_rules": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/interventionRule"}
    },
    "failure_injections": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/failureInjection"}
    },
    "recovery": {"$ref": "#/$defs/recovery"},
    "rollback": {"$ref": "#/$defs/rollback"},
    "proof_dimensions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    },
    "executable_requirements": {"$ref": "#/$defs/executableRequirements"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "example"],
      "properties": {
        "name": {"type": "string", "minLength": 3},
        "type": {"enum": ["string", "integer", "number", "boolean", "object", "array"]},
        "required": {"type": "boolean"},
        "example": {}
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "check"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "statement": {"type": "string", "minLength": 20},
        "check": {"type": "string", "minLength": 8}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind", "identity", "authorization_scope"],
      "properties": {
        "target_id": {"type": "string", "minLength": 4},
        "kind": {"type": "string", "minLength": 4},
        "identity": {"type": "string", "minLength": 8},
        "authorization_scope": {"type": "string", "minLength": 12}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_elapsed_ms", "max_calls", "max_tokens", "max_effects", "max_cost_usd"],
      "properties": {
        "max_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 15000},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_effects": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "phase", "proof_dimension", "criterion_ids", "min_count"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "kind": {"type": "string", "minLength": 4},
        "phase": {"enum": ["INPUT", "SOURCE", "BEFORE", "DECISION", "CONTROL", "AFTER", "RECOVERY", "ROLLBACK", "COMPENSATION", "VERIFICATION", "LEARNING"]},
        "proof_dimension": {"type": "string", "minLength": 5},
        "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "min_count": {"type": "integer", "minimum": 1}
      }
    },
    "successCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "statement": {"type": "string", "minLength": 20}
      }
    },
    "unacceptableOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "fail_code"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "statement": {"type": "string", "minLength": 20},
        "fail_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
      }
    },
    "interventionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "response", "status"],
      "properties": {
        "trigger": {"type": "string", "minLength": 12},
        "response": {"type": "string", "minLength": 12},
        "status": {"enum": ["FAIL", "BLOCKED", "NOT_TESTED", "WAITING"]}
      }
    },
    "failureInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inject", "expected_response"],
      "properties": {
        "id": {"type": "string", "minLength": 5},
        "inject": {"type": "string", "minLength": 15},
        "expected_response": {"type": "string", "minLength": 15}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "evidence_required", "max_elapsed_ms"],
      "properties": {
        "requirements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 15}},
        "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "max_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "evidence_required", "restoration_target"],
      "properties": {
        "requirements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 15}},
        "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "restoration_target": {"type": "string", "minLength": 15}
      }
    },
    "executableRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_independence",
        "stop_veto",
        "provenance",
        "freshness",
        "uncertainty",
        "contradictions_preserved",
        "usefulness",
        "idempotency",
        "after_state",
        "compensation",
        "recovery",
        "rollback",
        "allowed_effect_classes"
      ],
      "properties": {
        "actor_independence": {"type": "boolean"},
        "stop_veto": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "freshness": {"type": "boolean"},
        "uncertainty": {"type": "boolean"},
        "contradictions_preserved": {"type": "boolean"},
        "usefulness": {"type": "boolean"},
        "idempotency": {"type": "boolean"},
        "after_state": {"type": "boolean"},
        "compensation": {"type": "boolean"},
        "recovery": {"type": "boolean"},
        "rollback": {"type": "boolean"},
        "allowed_effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}}
      }
    }
  }
}
